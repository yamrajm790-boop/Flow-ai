# GEMINI_API_KEY: Injected by AI Studio platform.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Injected by AI Studio platform.
APP_URL="MY_APP_URL"

# Groq AI Configuration (Server-Side Only - Never exposed to frontend)
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
GROQ_MODEL="llama-3.3-70b-versatile"

# Supabase Configuration (Server-Side)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Supabase Client Configuration (Public / Frontend)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Frontend & Backend Cross-Origin Config (for Vercel & Render)
VITE_API_BASE_URL=""
FRONTEND_URL="http://localhost:3000"
